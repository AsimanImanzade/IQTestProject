# --- Database -------------------------------------------------------------
# Port 5433 (not 5432) so this never collides with a Postgres already on the host.
DATABASE_URL="postgresql://iq:iq_dev_password@localhost:5433/iq_test?schema=public"

# Separate database used by `npm run test:integration`. Never point this at DATABASE_URL:
# the integration suite truncates tables between tests.
TEST_DATABASE_URL="postgresql://iq:iq_dev_password@localhost:5433/iq_test_integration?schema=public"

# --- Auth -----------------------------------------------------------------
# 32+ random bytes. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# --- Question bank --------------------------------------------------------
# Items generated by `npm run db:seed`. The generators are loops, so raising this
# to 10000+ costs seed time only — no code or schema change.
SEED_COUNT=600

# Deterministic bank: the same seed always produces the same question bank.
SEED_RANDOM_SEED=20260722

# --- Test delivery --------------------------------------------------------
TEST_QUESTION_COUNT=20
TIMED_MODE_MINUTES=25
